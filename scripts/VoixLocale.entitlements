<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Requis avec le Hardened Runtime : sans cet entitlement, le processus est tué
         dès qu'il tente d'accéder au microphone. Ne pas activer com.apple.security.app-sandbox :
         l'application lance un backend Python et écrit dans Application Support. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
